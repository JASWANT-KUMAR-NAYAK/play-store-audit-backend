from uuid import uuid4

from fastapi import APIRouter, HTTPException

from api.schemas import AuditRequest, AuditResponse


router = APIRouter(prefix="/api")


# Temporary in-memory storage for Phase 10.
# Supabase will replace this later.
audits: dict[str, dict] = {}


@router.post("/audits", response_model=AuditResponse)
def create_audit(request: AuditRequest):
    audit_id = str(uuid4())

    audits[audit_id] = {
        "audit_id": audit_id,
        "target": request.target,
        "competitors": request.competitors,
        "country": request.country,
        "language": request.language,
        "status": "created",
    }

    return AuditResponse(
        audit_id=audit_id,
        status="created",
    )


@router.get("/audits/{audit_id}")
def get_audit(audit_id: str):
    audit = audits.get(audit_id)

    if audit is None:
        raise HTTPException(
            status_code=404,
            detail="Audit not found",
        )

    return audit