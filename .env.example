# --- LLM configuration (optional) ---
# Leave LLM_PROVIDER unset (or blank) to skip AI-generated insights entirely.
# The report will still generate using deterministic analysis only.
LLM_PROVIDER=

# Set only the key that matches LLM_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (sensible defaults are used if left blank).
ANTHROPIC_MODEL=
OPENAI_MODEL=

# --- Scraper / analysis tuning (optional overrides) ---
DEFAULT_COUNTRY=in
DEFAULT_LANG=en
REVIEW_SAMPLE_SIZE=180
